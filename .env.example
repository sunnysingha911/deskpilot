# Copy to .env and fill in only the providers you use. Never commit .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
# Local OpenAI-compatible server (Ollama default)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Python backend (Docker Compose: Postgres + API). Pick any long random password, e.g. `openssl rand -hex 24`.
DESKPILOT_DB_PASSWORD=
# The web app's access token (the API container and `uv run deskpilot open` share it): openssl rand -hex 24
DESKPILOT_UI_TOKEN=
# The backend outside Docker (tests, uv run deskpilot …) reaches the same database on localhost:
# DESKPILOT_DATABASE_URL=postgresql+asyncpg://deskpilot:<password>@127.0.0.1:5432/deskpilot
