{
  "name": "deskpilot",
  "version": "0.0.1",
  "private": true,
  "description": "deskpilot's web app (React + Vite). The backend is Python: see backend/.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:ui": "vite build --config ui/vite.config.ts",
    "dev:ui": "uv run --project backend deskpilot dev-ui",
    "typecheck": "tsc --noEmit -p ui/tsconfig.json",
    "build:native": "swift build -c release --package-path native/axhelper && swift build -c release --package-path native/overlay",
    "gui": "npm run -s build:ui && uv run --project backend deskpilot gui",
    "agent": "uv run --project backend deskpilot agent",
    "tool": "uv run --project backend deskpilot tool",
    "logs": "uv run --project backend deskpilot logs",
    "tokens": "uv run --project backend deskpilot tokens",
    "frontmost": "uv run --project backend deskpilot frontmost",
    "notes-demo": "uv run --project backend deskpilot notes-demo",
    "input-demo": "uv run --project backend deskpilot input-demo",
    "test": "cd backend && uv run pytest"
  },
  "devDependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "zod": "^4.6.7"
  }
}
