{
  "name": "deskpilot",
  "version": "0.0.1",
  "private": true,
  "description": "Text-first AI agents that operate your computer: tool layer, safety gate, and multi-provider agent loop",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "frontmost": "tsx scripts/frontmost-app.ts",
    "tool": "tsx scripts/tool.ts",
    "logs": "tsx scripts/logs.ts",
    "build:native": "swift build -c release --package-path native/axhelper && swift build -c release --package-path native/overlay",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui/tsconfig.json",
    "notes-demo": "tsx scripts/notes-demo.ts",
    "input-demo": "tsx scripts/input-demo.ts",
    "agent": "tsx scripts/agent.ts",
    "gui": "npm run -s build:ui && tsx scripts/gui.ts",
    "build:ui": "vite build --config ui/vite.config.ts",
    "dev:ui": "tsx scripts/dev-ui.ts"
  },
  "devDependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  }
}
